{
  "name": "laundry-order-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "社区洗衣店订单流转台(接单 -> 清洗 -> 质检 -> 待领取 -> 已取件)",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.web.json && vite build",
    "test": "vitest run",
    "start:api": "node dist-server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
